# Copy this file to .env and fill in your values
# Never commit .env to Git

# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/mosque-webapplication

# Authentication
JWT_SECRET=

# Encryption (AES-256 key - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=

# Email (Gmail - use App Password, not your real password)
EMAIL_USER=
EMAIL_PASS=

# Google OAuth (from Google Cloud Console)
REACT_APP_GOOGLE_MAPS_API_KEY=
